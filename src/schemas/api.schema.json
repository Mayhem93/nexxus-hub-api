{
  "$comment": "app",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "port": {
      "type": "number",
      "default": 9000
    },
    "logger": {
      "type": "string"
    },
    "database": {
      "type": "string"
    },
    "message_queue": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "maxPollFailures": {
      "type": "number",
      "default": 3
    },
    "refreshIntervalMs": {
      "type": "number",
      "default": 10000
    },
    "ssl": {
      "type": "object",
      "properties": {
        "sslKeyPath": {
          "type": "string"
        },
        "sslCertPath": {
          "type": "string"
        }
      },
      "required": [
        "sslKeyPath",
        "sslCertPath"
      ]
    }
  },
  "required": [
    "name",
    "logger",
    "database",
    "message_queue",
    "token"
  ]
}
